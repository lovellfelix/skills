{
  "schema_version": "1.0",
  "name": "api-docs",
  "version": "0.1.0",
  "portable": false,
  "runtime": "opencode",
  "entrypoint": "SKILL.md",
  "tags": [
    "api",
    "openapi",
    "swagger",
    "docs",
    "opencode"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      }
    }
  }
}
