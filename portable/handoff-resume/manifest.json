{
  "schema_version": "1.0",
  "name": "handoff-resume",
  "description": "Use when resuming interrupted work across sessions, handing off to another agent or teammate, or creating a restart-ready status snapshot.",
  "version": "0.2.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "workflow",
    "continuity",
    "handoff",
    "resume",
    "portable"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
