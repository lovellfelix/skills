{
  "schema_version": "1.0",
  "name": "mcp-builder",
  "description": "Use when building or extending an MCP (Model Context Protocol) server to expose external APIs or services to LLMs, in Python (FastMCP) or Node/TypeScript (MCP SDK).",
  "version": "1.0.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": ["mcp", "tools", "integration", "server"],
  "adapters": {
    "opencode": { "path": "SKILL.md", "mode": "native" },
    "cursor": { "path": "SKILL.md", "mode": "import" },
    "claude": { "path": "SKILL.md", "mode": "include" },
    "copilot": { "path": "SKILL.md", "mode": "include" },
    "pi": { "path": "SKILL.md", "mode": "include" }
  },
  "compatibility": {
    "runtimes": {
      "opencode": { "min_version": "*" },
      "cursor": { "min_version": "*" },
      "claude": { "min_version": "*" },
      "copilot": { "min_version": "*" },
      "pi": { "min_version": "*" }
    }
  }
}
