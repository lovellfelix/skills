{
  "schema_version": "1.0",
  "name": "context-optimization",
  "description": "Use when exploring a large or unfamiliar codebase, handling long tool or log output, approaching context limits, or optimizing a session for token cost and context bloat.",
  "version": "0.2.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "performance",
    "optimization",
    "context",
    "tokens",
    "efficiency"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
