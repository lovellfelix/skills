{
  "schema_version": "1.0",
  "name": "work-search",
  "version": "0.1.0",
  "portable": true,
  "work_machine_only": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "captain",
    "jarvis",
    "jira",
    "confluence",
    "google",
    "slack",
    "work",
    "portable"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "cursor": {
      "path": "SKILL.md",
      "mode": "import"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "copilot": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "cursor": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "copilot": {
        "min_version": "*"
      }
    }
  }
}
