{
  "schema_version": "1.0",
  "name": "git-workflow",
  "description": "Use when setting up git worktrees, writing or installing git hooks, recovering from a bad merge/rebase/reset, untangling history, or automating multi-branch workflows beyond routine commit/push. Not for commit message wording (see commit-messages).",
  "version": "0.2.1",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "git",
    "automation",
    "worktrees",
    "hooks",
    "rebase",
    "recovery",
    "version-control",
    "workflow"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
