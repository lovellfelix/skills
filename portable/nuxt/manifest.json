{
  "schema_version": "1.0",
  "name": "nuxt",
  "description": "Use when working with Nuxt apps, server routes, useFetch, middleware, or hybrid rendering in a full-stack Vue application.",
  "version": "2026.1.28",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "nuxt",
    "vue",
    "nitro",
    "ssr",
    "routing",
    "portable"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  },
  "personal_machine_only": true
}
