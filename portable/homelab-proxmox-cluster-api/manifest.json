{
  "schema_version": "1.0",
  "name": "homelab-proxmox-cluster-api",
  "description": "Use when operating the personal homelab Kubernetes cluster on Proxmox through Cluster API and CAPMOX, especially for workload cluster rebuilds, kubeadm upgrades, templateID changes, ProxmoxMachineTemplate edits, CAPMOX boot bug recovery, management-cluster checks, cluster-status validation, or control-plane local-zfs migration planning.",
  "version": "0.1.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "homelab",
    "proxmox",
    "cluster-api",
    "capmox",
    "kubernetes",
    "kubeadm",
    "infrastructure"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "cursor": {
      "path": "SKILL.md",
      "mode": "import"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "copilot": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "cursor": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "copilot": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  },
  "work_machine_only": false,
  "personal_machine_only": true
}
