{
  "schema_version": "1.0",
  "name": "llm-wiki-workflow",
  "description": "Use when searching, reading, ingesting, or updating ~/llm-wiki via the llm-wiki CLI. Wiki is the primary durable layer for curated project knowledge; session-memory is for live in-session context.",
  "version": "0.3.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": ["llm-wiki", "memory", "workflow", "obsidian", "markdown"],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  },
  "personal_machine_only": true
}
