{
  "schema_version": "1.0",
  "name": "knowledgebase-workflow",
  "description": "Use when organizing, searching, or updating the personal knowledgebase via Obsidian vault or work notes.",
  "version": "1.1.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "knowledgebase",
    "workflow",
    "documentation",
    "notes",
    "obsidian",
    "backlinks",
    "graph"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "cursor": {
      "path": "SKILL.md",
      "mode": "import"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "copilot": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "cursor": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "copilot": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  },
  "personal_machine_only": true
}
