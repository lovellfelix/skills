{
  "schema_version": "1.0",
  "name": "release-skills",
  "description": "Use when releasing a new version, bumping semver, generating changelogs, or publishing to npm, PyPI, Cargo, or GitHub.",
  "version": "1.0.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "release",
    "versioning",
    "changelog",
    "semver",
    "publishing",
    "sbom",
    "portable"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
