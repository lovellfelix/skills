{
  "schema_version": "1.0",
  "name": "homelab-gitops-flux-operations",
  "version": "0.1.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "homelab",
    "flux",
    "gitops",
    "kubernetes",
    "helmrelease",
    "home-assistant",
    "sops",
    "portable"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "cursor": {
      "path": "SKILL.md",
      "mode": "import"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "copilot": {
      "path": "SKILL.md",
