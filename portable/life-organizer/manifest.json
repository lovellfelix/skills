{
  "schema_version": "1.0",
  "name": "life-organizer",
  "description": "Use when the user asks to review personal reminders, calendar events, Apple Notes context, family plans, or general life-admin tasks on a macOS machine.",
  "version": "0.1.0",
  "portable": true,
  "personal_machine_only": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "personal",
    "reminders",
    "calendar",
    "notes",
    "family",
    "planning",
    "macos"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "cursor": {
      "path": "SKILL.md",
      "mode": "import"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "copilot": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "cursor": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "copilot": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
