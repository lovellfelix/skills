{
  "schema_version": "1.0",
  "name": "dotfiles-optimization",
  "description": "Use when improving shell configs, dotfiles layout, or local automation with safe, validated changes.",
  "version": "0.1.1",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "dotfiles",
    "shell",
    "zsh",
    "nvim",
    "stow",
    "automation"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
