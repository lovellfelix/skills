{
  "schema_version": "1.0",
  "name": "writing-modern-python",
  "description": "Use when implementing or modifying Python code and pytest tests and need concise, typed, production-ready changes with modern syntax, walrus-operator patterns, fixtures, annotated mocks, @patch usage, and Ruff or pytest quality gates.",
  "version": "0.1.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "python",
    "pytest",
    "quality",
    "testing",
    "portable"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "cursor": {
      "path": "SKILL.md",
      "mode": "import"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "copilot": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "cursor": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "copilot": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
