{
  "schema_version": "1.0",
  "name": "writing-skills",
  "description": "Use when creating a new skill or custom command, editing, consolidating, or retiring an existing one, reviewing a skill library for quality, or verifying a skill actually changes agent behavior before relying on it.",
  "version": "0.3.1",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "skills",
    "commands",
    "authoring",
    "validation",
    "maintenance",
    "documentation",
    "portable"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
