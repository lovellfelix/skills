{
  "schema_version": "1.0",
  "name": "pass-secrets-management",
  "description": "Use when agents need to retrieve or store secrets/passwords/credentials backed by the pass CLI, or when a human operator is provisioning/rotating credentials via pass-run.sh/pass-store.sh.",
  "version": "0.5.0",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "pass",
    "secrets",
    "passwords",
    "credentials",
    "security",
    "gpg",
    "password-store",
    "agent-automation",
    "anti-leak",
    "permission-escalation",
    "version-control",
    "ssh",
    "key-rotation",
    "pass-run",
    "pass-store"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
