{
  "schema_version": "1.0",
  "name": "rfc",
  "description": "Use when writing an RFC, technical design doc, or architecture proposal for a significant engineering change, or when reviewing one (yours or someone else's) for structural, clarity, and completeness gaps before it is shared.",
  "version": "1.1.1",
  "portable": true,
  "entrypoint": "SKILL.md",
  "tags": [
    "rfc",
    "architecture",
    "design",
    "design-review",
    "mermaid",
    "rubric",
    "tradeoffs",
    "rollout"
  ],
  "adapters": {
    "opencode": {
      "path": "SKILL.md",
      "mode": "native"
    },
    "claude": {
      "path": "SKILL.md",
      "mode": "include"
    },
    "pi": {
      "path": "SKILL.md",
      "mode": "include"
    }
  },
  "compatibility": {
    "runtimes": {
      "opencode": {
        "min_version": "*"
      },
      "claude": {
        "min_version": "*"
      },
      "pi": {
        "min_version": "*"
      }
    }
  }
}
